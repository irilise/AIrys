# AIrys Configuration Template
# Copy this file to .env and customize as needed

# ==================== Ollama Configuration ====================
# URL of your Ollama instance (default: http://localhost:11434)
OLLAMA_HOST=http://localhost:11434

# Name of the LLM model to use (must be loaded in Ollama first)
# Run: ollama run <model-name>
OLLAMA_MODEL=llama3.2

# Optional Ollama model for semantic embeddings. If unset, AIrys uses the
# sentence-transformers fallback, independent of the selected chat model.
# EMBEDDING_MODEL=nomic-embed-text

# ==================== Server Configuration ====================
# Host for the API server (for Docker or different environments)
HOST=127.0.0.1

# Port for the API server
PORT=7860

# ==================== Data Directories ====================
# Root directory for all data files
DATA_DIR=./data

# Directory for conversation histories
CONVERSATIONS_DIR=./data/conversations

# Directory for vector embeddings (ChromaDB)
EMBEDDINGS_DIR=./data/embeddings

# ==================== Allowed Origins (for CORS) ====================
# Frontend URLs that can communicate with the backend
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173"]
